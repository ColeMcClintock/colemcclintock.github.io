{
  "name": "Cole McClintock Portfolio - Dark Navy",
  "dataColors": [
    "#5AA6E6",
    "#A9B97A",
    "#E3B34C",
    "#5FBF7F",
    "#B48EE0",
    "#E08AB4",
    "#D6C48F",
    "#E0645C",
    "#7FC8C2",
    "#8A9A5B"
  ],
  "foreground": "#E7EDF5",
  "foregroundNeutralSecondary": "#9FB0C6",
  "foregroundNeutralTertiary": "#6F829C",
  "background": "#0A1424",
  "backgroundLight": "#132540",
  "backgroundNeutral": "#24406A",
  "secondaryBackground": "#132540",
  "tableAccent": "#8A9A5B",
  "good": "#5FBF7F",
  "neutral": "#E3B34C",
  "bad": "#E0645C",
  "maximum": "#E0645C",
  "center": "#E3B34C",
  "minimum": "#5FBF7F",
  "null": "#9FB0C6",
  "hyperlink": "#A9B97A",
  "visitedHyperlink": "#8A9A5B",
  "textClasses": {
    "callout": {
      "fontSize": 28,
      "fontFace": "Segoe UI Semibold",
      "color": "#E7EDF5"
    },
    "title": {
      "fontSize": 12,
      "fontFace": "Segoe UI Semibold",
      "color": "#E7EDF5"
    },
    "header": {
      "fontSize": 12,
      "fontFace": "Segoe UI Semibold",
      "color": "#E7EDF5"
    },
    "label": {
      "fontSize": 10,
      "fontFace": "Segoe UI",
      "color": "#9FB0C6"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#132540"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#24406A"
              }
            },
            "radius": 8
          }
        ],
        "title": [
          {
            "show": true,
            "fontColor": {
              "solid": {
                "color": "#E7EDF5"
              }
            },
            "fontSize": 12,
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#0A1424"
              }
            },
            "transparency": 0
          }
        ],
        "outspace": [
          {
            "color": {
              "solid": {
                "color": "#0A1424"
              }
            },
            "transparency": 0
          }
        ]
      }
    },
    "card": {
      "*": {
        "labels": [
          {
            "color": {
              "solid": {
                "color": "#E7EDF5"
              }
            },
            "fontSize": 26
          }
        ],
        "categoryLabels": [
          {
            "color": {
              "solid": {
                "color": "#9FB0C6"
              }
            },
            "fontSize": 10
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "items": [
          {
            "fontColor": {
              "solid": {
                "color": "#E7EDF5"
              }
            }
          }
        ],
        "header": [
          {
            "fontColor": {
              "solid": {
                "color": "#A9B97A"
              }
            }
          }
        ]
      }
    }
  }
}