// ===== 03_safety.dax : ASMIS accidents, investigations, costs, rates =====
// FactAccident[Accident Date] -> 'Date'[Date]; FactAccident[Battalion] -> DimBattalion[Battalion]
// Accident Class codes after the M query: A, B, C, D, E (Ground), R (NG), Unclassified (blank), or the raw value.
// Open = Status <> "Final". Overdue = open and past Due Date (Accident Date + 90 days).

Accidents =
COUNTROWS ( FactAccident )                                                   // Whole number

Class A Accidents =
CALCULATE ( [Accidents], FactAccident[Accident Class] = "A" )

Class B Accidents =
CALCULATE ( [Accidents], FactAccident[Accident Class] = "B" )

Class C Accidents =
CALCULATE ( [Accidents], FactAccident[Accident Class] = "C" )

Class D Accidents =
CALCULATE ( [Accidents], FactAccident[Accident Class] = "D" )

Class E (Ground) Accidents =
CALCULATE ( [Accidents], FactAccident[Accident Class] = "E" )

Class R (NG) Accidents =
CALCULATE ( [Accidents], FactAccident[Accident Class] = "R" )

Unclassified Accidents =
CALCULATE ( [Accidents], FactAccident[Accident Class] = "Unclassified" )   // blank class = not yet classified

Other Class Accidents =
CALCULATE ( [Accidents], NOT FactAccident[Accident Class] IN { "A", "B", "C", "D", "E", "R", "Unclassified" } )

Injury Accidents =
CALCULATE ( [Accidents], FactAccident[Injury Y/N] = "Y" )

Off Duty Accidents =
CALCULATE ( [Accidents], FactAccident[On Duty] = "N" )

// ---- Investigations ----
Open Investigations =
CALCULATE ( [Accidents], FactAccident[Status] <> "Final" )

Overdue Investigations =
COUNTROWS (
    FILTER ( FactAccident, FactAccident[Status] <> "Final" && FactAccident[Due Date (Calc)] < TODAY () )
)

Overdue Investigations % =
DIVIDE ( [Overdue Investigations], [Open Investigations] )                    // Percentage, 0 dp

Oldest Overdue (days) =
MAXX (
    FILTER ( FactAccident, FactAccident[Status] <> "Final" && FactAccident[Due Date (Calc)] < TODAY () ),
    DATEDIFF ( FactAccident[Due Date (Calc)], TODAY (), DAY )
)

// Use in a table with one accident per row (e.g. CCIR #) for conditional icons
Investigation RAG =
VAR _due = SELECTEDVALUE ( FactAccident[Due Date (Calc)] )
VAR _status = SELECTEDVALUE ( FactAccident[Status] )
RETURN
    SWITCH (
        TRUE (),
        ISBLANK ( _due ), BLANK (),
        _status = "Final", "Final",
        _due < TODAY (), "Red",
        _due <= TODAY () + 30, "Amber",
        "Green"
    )

Investigation RAG Color =
SWITCH ( [Investigation RAG], "Red", "#E0645C", "Amber", "#E3B34C", "Green", "#5FBF7F", "#8B9BB0" )

// ---- Costs (blank Material ECOD counts as $0) ----
Total Accident Cost =
SUM ( FactAccident[Total Accident Cost] )                                    // Currency

Injury Cost =
SUM ( FactAccident[Injury Cost] )

Material ECOD =
SUM ( FactAccident[Material ECOD] )

Accidents With Material Damage =
CALCULATE ( [Accidents], FactAccident[Material ECOD] > 0 )

Days Away Cost =
SUM ( FactAccident[Days Away from Work Cost] )

Days Hospitalized Cost =
SUM ( FactAccident[Days Hospitalized Cost] )

PPD Cost =
SUM ( FactAccident[Perm. Partial Disability Cost] )

PTD Cost =
SUM ( FactAccident[Perm. Total Disability Cost] )

Fatality Cost =
SUM ( FactAccident[Fatality Cost] )

Days Lost =
SUM ( FactAccident[Days Lost] )

Days Restricted =
SUM ( FactAccident[Days Restricted] )

// ---- Time ----
Days Since Last Class A/B =
VAR _end = MIN ( TODAY (), MAX ( 'Date'[Date] ) )
VAR _last =
    CALCULATE (
        MAX ( FactAccident[Accident Date] ),
        FactAccident[Accident Class] IN { "A", "B" },
        REMOVEFILTERS ( 'Date' ),
        FactAccident[Accident Date] <= _end
    )
RETURN IF ( NOT ISBLANK ( _last ), DATEDIFF ( _last, _end, DAY ) )

Accidents FYTD =
CALCULATE ( [Accidents], DATESYTD ( 'Date'[Date], "9-30" ) )

Accidents PFYTD =
CALCULATE ( [Accidents], DATESYTD ( DATEADD ( 'Date'[Date], -1, YEAR ), "9-30" ) )

Accidents FYTD vs PFYTD =
[Accidents FYTD] - [Accidents PFYTD]

// ---- Rates (needs DimBattalion[Assigned]) ----
Assigned Strength =
SUM ( DimBattalion[Assigned] )

Days In Range =
VAR _first = MAX ( MIN ( 'Date'[Date] ), CALCULATE ( MIN ( FactAccident[Accident Date] ), REMOVEFILTERS () ) )
VAR _last  = MIN ( MAX ( 'Date'[Date] ), TODAY () )
RETURN MAX ( 0, DATEDIFF ( _first, _last, DAY ) + 1 )

Accidents per 1,000 (annualized) =
DIVIDE ( [Accidents], [Assigned Strength] ) * 1000 * DIVIDE ( 365.25, [Days In Range] )     // Decimal, 2 dp

Class A-C per 1,000 (annualized) =
DIVIDE ( [Class A Accidents] + [Class B Accidents] + [Class C Accidents], [Assigned Strength] ) * 1000 * DIVIDE ( 365.25, [Days In Range] )

// ---- Demographics: show only groups of 3 or more ----
Accidents (suppressed <3) =
VAR _n = [Accidents]
RETURN IF ( _n >= 3, _n )

// ---- Narrative (no personal or demographic details) ----
Safety Summary =
VAR _n = [Accidents]
VAR _ab = [Class A Accidents] + [Class B Accidents]
VAR _u = [Unclassified Accidents]
RETURN
    FORMAT ( _n, "0" ) & " accidents (" & FORMAT ( _ab, "0" ) & " Class A/B" & IF ( _u > 0, ", " & FORMAT ( _u, "0" ) & " not yet classified" ) & "), total cost "
        & FORMAT ( [Total Accident Cost], "$#,0" ) & ". "
        & FORMAT ( [Open Investigations], "0" ) & " investigations open, "
        & FORMAT ( [Overdue Investigations], "0" ) & " past the 90-day suspense. "
        & IF ( NOT ISBLANK ( [Days Since Last Class A/B] ), FORMAT ( [Days Since Last Class A/B], "0" ) & " days since the last Class A/B.", "" )

// ---- Multi-file loads (22_FactAccident_Folder.pq) ----
Source Files Loaded =
DISTINCTCOUNT ( FactAccident[Source File] )

Accidents per FY (avg) =
AVERAGEX ( VALUES ( 'Date'[Fiscal Year] ), [Accidents] )
