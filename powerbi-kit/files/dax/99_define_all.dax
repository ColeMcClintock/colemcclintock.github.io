// ===== 99_define_all.dax =====
// Paste into DAX query view, then use 'Update model with changes' (or copy measures individually).
// Requires the measures table named _Measures.
DEFINE
    MEASURE _Measures[As Of Month] =
        FORMAT ( MAX ( 'Date'[Date] ), "mmm yyyy" )
    MEASURE _Measures[Selected Scope] =
        VAR _bde = IF ( ISFILTERED ( DimUnit[brigade] ), SELECTEDVALUE ( DimUnit[brigade], "Multiple brigades" ) )
        VAR _bn  = IF ( ISFILTERED ( DimUnit[battalion] ), SELECTEDVALUE ( DimUnit[battalion], "Multiple battalions" ) )
        VAR _loc = IF ( ISFILTERED ( DimUnit[location] ), SELECTEDVALUE ( DimUnit[location], "Multiple locations" ) )
        VAR _parts = CONCATENATEX ( FILTER ( { _bde, _bn, _loc }, NOT ISBLANK ( [Value] ) ), [Value], " > " )
        RETURN IF ( _parts = "", "All units statewide", _parts )
    MEASURE _Measures[Title Readiness] =
        "Readiness Command Dashboard | " & [Selected Scope] & " | as of " & [As Of Month]
    MEASURE _Measures[Title Safety] =
        VAR _msc = IF ( ISFILTERED ( DimBattalion[MSC] ), SELECTEDVALUE ( DimBattalion[MSC], "Multiple MSCs" ) )
        VAR _bn  = IF ( ISFILTERED ( DimBattalion[Battalion] ), SELECTEDVALUE ( DimBattalion[Battalion], "Multiple battalions" ) )
        VAR _scope = CONCATENATEX ( FILTER ( { _msc, _bn }, NOT ISBLANK ( [Value] ) ), [Value], " > " )
        RETURN "Safety & Mishaps | " & IF ( _scope = "", "All MSCs", _scope ) & " | through " & [As Of Month]
    MEASURE _Measures[Title Finance] =
        VAR _fy = SELECTEDVALUE ( 'Date'[Fiscal Year], "All fiscal years" )
        VAR _appn = SELECTEDVALUE ( DimProgram[appropriation], "All appropriations" )
        RETURN "Status of Funds | " & _fy & " as of " & [As Of Month] & " | " & _appn
    MEASURE _Measures[Last Refresh Note] =
        "Data shown is fictional for demonstration."
    MEASURE _Measures[Assigned] =
        SUM ( FactReadiness[assigned] )                                   // Whole number
    MEASURE _Measures[Authorized] =
        SUM ( FactReadiness[authorized] )                                 // Whole number
    MEASURE _Measures[Strength %] =
        DIVIDE ( [Assigned], [Authorized] )                               // Percentage, 1 dp
    MEASURE _Measures[MOSQ %] =
        DIVIDE ( SUMX ( FactReadiness, FactReadiness[mosq_pct] * FactReadiness[assigned] ), [Assigned] ) / 100
    MEASURE _Measures[Medically Ready %] =
        DIVIDE ( SUM ( FactReadiness[mrc1] ) + SUM ( FactReadiness[mrc2] ), [Assigned] )
    MEASURE _Measures[Equipment On-Hand %] =
        DIVIDE ( SUMX ( FactReadiness, FactReadiness[equip_on_hand_pct] * FactReadiness[authorized] ), [Authorized] ) / 100
    MEASURE _Measures[Equipment OR %] =
        DIVIDE ( SUMX ( FactReadiness, FactReadiness[equip_or_pct] * FactReadiness[authorized] ), [Authorized] ) / 100
    MEASURE _Measures[Individual Training %] =
        DIVIDE ( SUMX ( FactReadiness, FactReadiness[ind_training_pct] * FactReadiness[assigned] ), [Assigned] ) / 100
    MEASURE _Measures[Collective Training %] =
        DIVIDE ( SUMX ( FactReadiness, FactReadiness[coll_training_pct] * FactReadiness[assigned] ), [Assigned] ) / 100
    MEASURE _Measures[Units Reporting] =
        DISTINCTCOUNT ( FactReadiness[unit_id] )
    MEASURE _Measures[Units C1-C2] =
        CALCULATE ( [Units Reporting], FactReadiness[readiness_rating] IN { "C1", "C2" } )
    MEASURE _Measures[Units C1-C2 %] =
        DIVIDE ( [Units C1-C2], [Units Reporting] )
        // ---- Month-over-month (requires a contiguous, marked 'Date' table) ----
    MEASURE _Measures[Strength % PM] =
        CALCULATE ( [Strength %], DATEADD ( 'Date'[Date], -1, MONTH ) )
    MEASURE _Measures[Strength % MoM] =
        IF ( NOT ISBLANK ( [Strength % PM] ), [Strength %] - [Strength % PM] )   // format as 0.0% ; shows points
    MEASURE _Measures[Medically Ready % MoM] =
        VAR _pm = CALCULATE ( [Medically Ready %], DATEADD ( 'Date'[Date], -1, MONTH ) )
        RETURN IF ( NOT ISBLANK ( _pm ), [Medically Ready %] - _pm )
    MEASURE _Measures[Equipment OR % MoM] =
        VAR _pm = CALCULATE ( [Equipment OR %], DATEADD ( 'Date'[Date], -1, MONTH ) )
        RETURN IF ( NOT ISBLANK ( _pm ), [Equipment OR %] - _pm )
    MEASURE _Measures[Strength % YoY] =
        VAR _py = CALCULATE ( [Strength %], SAMEPERIODLASTYEAR ( 'Date'[Date] ) )
        RETURN IF ( NOT ISBLANK ( _py ), [Strength %] - _py )
        // ---- Attention score & ranking (same standards as the web dashboard) ----
    MEASURE _Measures[Attention Score] =
        VAR _gap =
            MAX ( 0, 0.90 - [Strength %] ) + MAX ( 0, 0.85 - [MOSQ %] ) + MAX ( 0, 0.85 - [Medically Ready %] )
                + MAX ( 0, 0.90 - [Equipment On-Hand %] ) + MAX ( 0, 0.85 - [Equipment OR %] )
                + MAX ( 0, 0.85 - [Individual Training %] ) + MAX ( 0, 0.80 - [Collective Training %] )
        VAR _rating = SELECTEDVALUE ( FactReadiness[readiness_rating] )
        VAR _penalty = SWITCH ( _rating, "C3", 5, "C4", 12, 0 )
        RETURN IF ( NOT ISBLANK ( [Assigned] ), _gap * 100 + _penalty )
    MEASURE _Measures[Unit Attention Rank] =
        IF (
            HASONEVALUE ( DimUnit[unit_name] ),
            RANKX ( ALLSELECTED ( DimUnit[unit_name] ), [Attention Score], , DESC, DENSE )
        )
    MEASURE _Measures[Top Driver] =
        VAR _t =
            {
                ( "Strength", 0.90 - [Strength %] ), ( "MOSQ", 0.85 - [MOSQ %] ), ( "Medical", 0.85 - [Medically Ready %] ),
                ( "Equip on-hand", 0.90 - [Equipment On-Hand %] ), ( "Equip OR", 0.85 - [Equipment OR %] ),
                ( "Indiv. training", 0.85 - [Individual Training %] ), ( "Coll. training", 0.80 - [Collective Training %] )
            }
        VAR _top = TOPN ( 1, _t, [Value2], DESC )
        RETURN IF ( MAXX ( _top, [Value2] ) > 0, MAXX ( _top, [Value1] ), "Meets standards" )
        // Conditional-format helper: 1 = good, 0 = watch, -1 = below standard
    MEASURE _Measures[Strength Status] =
        SWITCH ( TRUE (), [Strength %] >= 0.90, 1, [Strength %] >= 0.83, 0, -1 )
    MEASURE _Measures[Accidents] =
        COUNTROWS ( FactAccident )                                                   // Whole number
    MEASURE _Measures[Class A Accidents] =
        CALCULATE ( [Accidents], FactAccident[Accident Class] = "A" )
    MEASURE _Measures[Class B Accidents] =
        CALCULATE ( [Accidents], FactAccident[Accident Class] = "B" )
    MEASURE _Measures[Class C Accidents] =
        CALCULATE ( [Accidents], FactAccident[Accident Class] = "C" )
    MEASURE _Measures[Class D Accidents] =
        CALCULATE ( [Accidents], FactAccident[Accident Class] = "D" )
    MEASURE _Measures[Class E (Ground) Accidents] =
        CALCULATE ( [Accidents], FactAccident[Accident Class] = "E" )
    MEASURE _Measures[Class R (NG) Accidents] =
        CALCULATE ( [Accidents], FactAccident[Accident Class] = "R" )
    MEASURE _Measures[Unclassified Accidents] =
        CALCULATE ( [Accidents], FactAccident[Accident Class] = "Unclassified" )   // blank class = not yet classified
    MEASURE _Measures[Other Class Accidents] =
        CALCULATE ( [Accidents], NOT FactAccident[Accident Class] IN { "A", "B", "C", "D", "E", "R", "Unclassified" } )
    MEASURE _Measures[Injury Accidents] =
        CALCULATE ( [Accidents], FactAccident[Injury Y/N] = "Y" )
    MEASURE _Measures[Off Duty Accidents] =
        CALCULATE ( [Accidents], FactAccident[On Duty] = "N" )
        // ---- Investigations ----
    MEASURE _Measures[Open Investigations] =
        CALCULATE ( [Accidents], FactAccident[Status] <> "Final" )
    MEASURE _Measures[Overdue Investigations] =
        COUNTROWS (
            FILTER ( FactAccident, FactAccident[Status] <> "Final" && FactAccident[Due Date (Calc)] < TODAY () )
        )
    MEASURE _Measures[Overdue Investigations %] =
        DIVIDE ( [Overdue Investigations], [Open Investigations] )                    // Percentage, 0 dp
    MEASURE _Measures[Oldest Overdue (days)] =
        MAXX (
            FILTER ( FactAccident, FactAccident[Status] <> "Final" && FactAccident[Due Date (Calc)] < TODAY () ),
            DATEDIFF ( FactAccident[Due Date (Calc)], TODAY (), DAY )
        )
        // Use in a table with one accident per row (e.g. CCIR #) for conditional icons
    MEASURE _Measures[Investigation RAG] =
        VAR _due = SELECTEDVALUE ( FactAccident[Due Date (Calc)] )
        VAR _status = SELECTEDVALUE ( FactAccident[Status] )
        RETURN
            SWITCH (
                TRUE (),
                ISBLANK ( _due ), BLANK (),
                _status = "Final", "Final",
                _due < TODAY (), "Red",
                _due <= TODAY () + 30, "Amber",
                "Green"
            )
    MEASURE _Measures[Investigation RAG Color] =
        SWITCH ( [Investigation RAG], "Red", "#E0645C", "Amber", "#E3B34C", "Green", "#5FBF7F", "#8B9BB0" )
        // ---- Costs (blank Material ECOD counts as $0) ----
    MEASURE _Measures[Total Accident Cost] =
        SUM ( FactAccident[Total Accident Cost] )                                    // Currency
    MEASURE _Measures[Injury Cost] =
        SUM ( FactAccident[Injury Cost] )
    MEASURE _Measures[Material ECOD] =
        SUM ( FactAccident[Material ECOD] )
    MEASURE _Measures[Accidents With Material Damage] =
        CALCULATE ( [Accidents], FactAccident[Material ECOD] > 0 )
    MEASURE _Measures[Days Away Cost] =
        SUM ( FactAccident[Days Away from Work Cost] )
    MEASURE _Measures[Days Hospitalized Cost] =
        SUM ( FactAccident[Days Hospitalized Cost] )
    MEASURE _Measures[PPD Cost] =
        SUM ( FactAccident[Perm. Partial Disability Cost] )
    MEASURE _Measures[PTD Cost] =
        SUM ( FactAccident[Perm. Total Disability Cost] )
    MEASURE _Measures[Fatality Cost] =
        SUM ( FactAccident[Fatality Cost] )
    MEASURE _Measures[Days Lost] =
        SUM ( FactAccident[Days Lost] )
    MEASURE _Measures[Days Restricted] =
        SUM ( FactAccident[Days Restricted] )
        // ---- Time ----
    MEASURE _Measures[Days Since Last Class A/B] =
        VAR _end = MIN ( TODAY (), MAX ( 'Date'[Date] ) )
        VAR _last =
            CALCULATE (
                MAX ( FactAccident[Accident Date] ),
                FactAccident[Accident Class] IN { "A", "B" },
                REMOVEFILTERS ( 'Date' ),
                FactAccident[Accident Date] <= _end
            )
        RETURN IF ( NOT ISBLANK ( _last ), DATEDIFF ( _last, _end, DAY ) )
    MEASURE _Measures[Accidents FYTD] =
        CALCULATE ( [Accidents], DATESYTD ( 'Date'[Date], "9-30" ) )
    MEASURE _Measures[Accidents PFYTD] =
        CALCULATE ( [Accidents], DATESYTD ( DATEADD ( 'Date'[Date], -1, YEAR ), "9-30" ) )
    MEASURE _Measures[Accidents FYTD vs PFYTD] =
        [Accidents FYTD] - [Accidents PFYTD]
        // ---- Rates (needs DimBattalion[Assigned]) ----
    MEASURE _Measures[Assigned Strength] =
        SUM ( DimBattalion[Assigned] )
    MEASURE _Measures[Days In Range] =
        VAR _first = MAX ( MIN ( 'Date'[Date] ), CALCULATE ( MIN ( FactAccident[Accident Date] ), REMOVEFILTERS () ) )
        VAR _last  = MIN ( MAX ( 'Date'[Date] ), TODAY () )
        RETURN MAX ( 0, DATEDIFF ( _first, _last, DAY ) + 1 )
    MEASURE _Measures[Accidents per 1,000 (annualized)] =
        DIVIDE ( [Accidents], [Assigned Strength] ) * 1000 * DIVIDE ( 365.25, [Days In Range] )     // Decimal, 2 dp
    MEASURE _Measures[Class A-C per 1,000 (annualized)] =
        DIVIDE ( [Class A Accidents] + [Class B Accidents] + [Class C Accidents], [Assigned Strength] ) * 1000 * DIVIDE ( 365.25, [Days In Range] )
        // ---- Demographics: show only groups of 3 or more ----
    MEASURE _Measures[Accidents (suppressed <3)] =
        VAR _n = [Accidents]
        RETURN IF ( _n >= 3, _n )
        // ---- Narrative (no personal or demographic details) ----
    MEASURE _Measures[Safety Summary] =
        VAR _n = [Accidents]
        VAR _ab = [Class A Accidents] + [Class B Accidents]
        VAR _u = [Unclassified Accidents]
        RETURN
            FORMAT ( _n, "0" ) & " accidents (" & FORMAT ( _ab, "0" ) & " Class A/B" & IF ( _u > 0, ", " & FORMAT ( _u, "0" ) & " not yet classified" ) & "), total cost "
                & FORMAT ( [Total Accident Cost], "$#,0" ) & ". "
                & FORMAT ( [Open Investigations], "0" ) & " investigations open, "
                & FORMAT ( [Overdue Investigations], "0" ) & " past the 90-day suspense. "
                & IF ( NOT ISBLANK ( [Days Since Last Class A/B] ), FORMAT ( [Days Since Last Class A/B], "0" ) & " days since the last Class A/B.", "" )
    MEASURE _Measures[AFP] =
        CALCULATE ( SUM ( FactFunds[afp] ), REMOVEFILTERS ( 'Date' ), VALUES ( 'Date'[Fiscal Year] ) )   // Currency
    MEASURE _Measures[Allotted FYTD] =
        CALCULATE ( SUM ( FactFunds[allotment] ), DATESYTD ( 'Date'[Date], "9/30" ) )
    MEASURE _Measures[Committed FYTD] =
        CALCULATE ( SUM ( FactFunds[commitments] ), DATESYTD ( 'Date'[Date], "9/30" ) )
    MEASURE _Measures[Obligations FYTD] =
        CALCULATE ( SUM ( FactFunds[obligations] ), DATESYTD ( 'Date'[Date], "9/30" ) )
    MEASURE _Measures[Disbursements FYTD] =
        CALCULATE ( SUM ( FactFunds[disbursements] ), DATESYTD ( 'Date'[Date], "9/30" ) )
    MEASURE _Measures[Plan FYTD] =
        CALCULATE ( SUM ( FactFunds[plan_obligations] ), DATESYTD ( 'Date'[Date], "9/30" ) )
    MEASURE _Measures[TDY FYTD] =
        CALCULATE ( SUM ( FactFunds[tdy_obligations] ), DATESYTD ( 'Date'[Date], "9/30" ) )
    MEASURE _Measures[Obligation Rate] =
        DIVIDE ( [Obligations FYTD], [AFP] )                                          // Percentage
    MEASURE _Measures[Plan Rate] =
        DIVIDE ( [Plan FYTD], [AFP] )
    MEASURE _Measures[Variance to Plan (pts)] =
        [Obligation Rate] - [Plan Rate]                                               // format 0.0%
    MEASURE _Measures[Variance to Plan ($)] =
        [Obligations FYTD] - [Plan FYTD]
    MEASURE _Measures[Disbursement Rate] =
        DIVIDE ( [Disbursements FYTD], [Obligations FYTD] )
    MEASURE _Measures[Unobligated Balance] =
        [AFP] - [Obligations FYTD]
    MEASURE _Measures[Allotted Not Obligated] =
        [Allotted FYTD] - [Obligations FYTD]
    MEASURE _Measures[Open Commitments] =
        MAX ( 0, [Committed FYTD] - [Obligations FYTD] )
    MEASURE _Measures[Burn Rate (3-mo avg)] =
        VAR _end = MAX ( 'Date'[Date] )
        VAR _fyStart = DATE ( YEAR ( EDATE ( _end, 3 ) ) - 1, 10, 1 )
        VAR _win = FILTER ( DATESINPERIOD ( 'Date'[Date], _end, -3, MONTH ), 'Date'[Date] >= _fyStart )
        VAR _n = COUNTROWS ( CALCULATETABLE ( VALUES ( 'Date'[MonthStart] ), _win ) )
        RETURN DIVIDE ( CALCULATE ( SUM ( FactFunds[obligations] ), _win ), _n )
    MEASURE _Measures[Months Remaining in FY] =
        MOD ( 9 - MONTH ( MAX ( 'Date'[Date] ) ), 12 )
        // Plan-based projection: remaining plan x adjusted pace (same logic as the web dashboard)
    MEASURE _Measures[Projected EOY Obligations] =
        VAR _elapsed = 12 - [Months Remaining in FY]
        VAR _rows =
            ADDCOLUMNS (
                SUMMARIZE ( FactFunds, FactFunds[program_code], FactFunds[organization] ),
                "@afp", [AFP], "@obl", [Obligations FYTD], "@plan", [Plan FYTD]
            )
        RETURN
            SUMX (
                _rows,
                VAR _pace0 = IF ( [@plan] > 0, MIN ( 1.15, MAX ( 0.5, DIVIDE ( [@obl], [@plan] ) ) ), 1 )
                VAR _pace = 1 + ( _pace0 - 1 ) * 0.6 * MIN ( 1, _elapsed / 6 )
                RETURN MIN ( [@afp] * 1.05, [@obl] + MAX ( 0, [@afp] - [@plan] ) * _pace )
            )
    MEASURE _Measures[Projected EOY %] =
        DIVIDE ( [Projected EOY Obligations], [AFP] )
    MEASURE _Measures[Projected Unobligated at EOY] =
        MAX ( 0, [AFP] - [Projected EOY Obligations] )
    MEASURE _Measures[Is One-Year Money] =
        IF ( SELECTEDVALUE ( DimProgram[appropriation] ) IN { "NGPA", "OMNG", "STATE" }, 1, 0 )
    MEASURE _Measures[Use-or-Lose Flag] =
        VAR _rem = [Months Remaining in FY]
        RETURN
            SWITCH (
                TRUE (),
                _rem = 0 && [Obligation Rate] >= 0.99, "Closed",
                [Is One-Year Money] = 1 && _rem = 0, "Expired unobligated",
                [Is One-Year Money] = 1 && _rem <= 3 && [Projected EOY %] < 0.97 && [Projected Unobligated at EOY] > 25000, "Use-or-lose risk",
                [Variance to Plan (pts)] < -0.05, "Behind plan",
                [Variance to Plan (pts)] > 0.05, "Ahead of plan",
                "On track"
            )
    MEASURE _Measures[Variance Color] =
        SWITCH ( TRUE (), [Variance to Plan (pts)] < -0.05, "#E0645C", [Variance to Plan (pts)] < -0.02, "#E3B34C", "#5FBF7F" )   // use as field-value font/background color
    MEASURE _Measures[Program Variance Rank] =
        IF ( HASONEVALUE ( DimProgram[program_code] ), RANKX ( ALLSELECTED ( DimProgram[program_code] ), [Variance to Plan ($)], , ASC, DENSE ) )
    MEASURE _Measures[Open UFR Amount] =
        CALCULATE ( SUM ( FactUFR[amount] ), FactUFR[status] <> "Funded" )
    MEASURE _Measures[Resource Manager Summary] =
        "As of " & [As Of Month] & ": obligated " & FORMAT ( [Obligations FYTD], "$#,0.0,,M" ) & " of "
            & FORMAT ( [AFP], "$#,0.0,,M" ) & " (" & FORMAT ( [Obligation Rate], "0.0%" ) & ") vs plan "
            & FORMAT ( [Plan Rate], "0.0%" ) & ". Projected EOY execution " & FORMAT ( [Projected EOY %], "0.0%" )
            & "; open UFRs " & FORMAT ( [Open UFR Amount], "$#,0.0,,M" ) & "."
